    {
      "name": "dd236d68",
      "displayName": "sales_summary_KPI",
      "queryLines": [
        "SELECT \r\n",
        "  department_id AS Departamento,\r\n",
        "  is_organic AS Es_Organico,\r\n",
        "  total_orders AS Ventas_Totales,\r\n",
        "  total_reorders AS Recompras_Totales,\r\n",
        "  -- Calculamos el porcentaje de recompra\r\n",
        "  ROUND((total_reorders / total_orders) * 100, 2) AS Porcentaje_Recompra,\r\n",
        "  ROUND(avg_add_to_cart_order, 2) AS Posicion_Promedio_Carrito\r\n",
        "FROM catalog_au.golden.kpis_sales_summary_partitioned"
      ]
    },
    {
      "name": "4ff4da3d",
      "displayName": "departments_KPI",
      "queryLines": [
        "SELECT \r\n",
        "  CASE department_id\r\n",
        "    WHEN 1 THEN 'Congelados'\r\n",
        "    WHEN 3 THEN 'Panadería'\r\n",
        "    WHEN 4 THEN 'Frutas y Verduras'\r\n",
        "    WHEN 7 THEN 'Bebidas'\r\n",
        "    WHEN 12 THEN 'Carnes y Pescados'\r\n",
        "    WHEN 13 THEN 'Abarrotes'\r\n",
        "    WHEN 15 THEN 'Enlatados'\r\n",
        "    WHEN 16 THEN 'Lácteos y Huevos'\r\n",
        "    WHEN 19 THEN 'Snacks y Dulces'\r\n",
        "    ELSE CONCAT('Otro (ID ', department_id, ')')\r\n",
        "  END AS Departamento,\r\n",
        "  is_organic AS Es_Organico,\r\n",
        "  total_orders AS Ventas_Totales,\r\n",
        "  total_reorders AS Recompras_Totales,\r\n",
        "  ROUND((total_reorders / total_orders) * 100, 2) AS Porcentaje_Recompra,\r\n",
        "  ROUND(avg_add_to_cart_order, 2) AS Posicion_Promedio_Carrito\r\n",
        "FROM catalog_au.golden.kpis_sales_summary_partitioned"
      ]
    },
    {
      "name": "c16c8e4b",
      "displayName": "Categorios id_ KPI",
      "queryLines": [
        "SELECT DISTINCT\r\n",
        "  department_id AS ID_Departamento,\r\n",
        "  CASE department_id\r\n",
        "    WHEN 1 THEN 'Congelados'\r\n",
        "    WHEN 2 THEN 'Otros'\r\n",
        "    WHEN 3 THEN 'Panadería'\r\n",
        "    WHEN 4 THEN 'Frutas y Verduras'\r\n",
        "    WHEN 5 THEN 'Alcohol'\r\n",
        "    WHEN 6 THEN 'Internacional'\r\n",
        "    WHEN 7 THEN 'Bebidas'\r\n",
        "    WHEN 8 THEN 'Mascotas'\r\n",
        "    WHEN 9 THEN 'Pastas y Legumbres'\r\n",
        "    WHEN 10 THEN 'Venta a Granel'\r\n",
        "    WHEN 11 THEN 'Cuidado Personal'\r\n",
        "    WHEN 12 THEN 'Carnes y Pescados'\r\n",
        "    WHEN 13 THEN 'Despensa'\r\n",
        "    WHEN 14 THEN 'Desayunos'\r\n",
        "    WHEN 15 THEN 'Enlatados y Conservas'\r\n",
        "    WHEN 16 THEN 'Lácteos y Huevos'\r\n",
        "    WHEN 17 THEN 'Limpieza y Hogar'\r\n",
        "    WHEN 18 THEN 'Bebés'\r\n",
        "    WHEN 19 THEN 'Snacks y Dulces'\r\n",
        "    WHEN 20 THEN 'Fiambrería y Deli'\r\n",
        "    WHEN 21 THEN 'No Especificado'\r\n",
        "    ELSE CONCAT('Desconocido (ID ', department_id, ')')\r\n",
        "  END AS Nombre_Departamento\r\n",
        "FROM catalog_au.golden.kpis_sales_summary_partitioned\r\n",
        "ORDER BY ID_Departamento ASC"
      ]
    }
